{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config (don't use directly!)",
            "generator": "Ninja Multi-Config",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Release,Debug,RelWithDebInfo>:Embedded>",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "win64",
            "inherits": "default",
            "hidden": false,
            "displayName": "Windows 64bit Release",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "RTS_FLAGS": "/W3"
            }
        },
        {
            "name": "win64-debug",
            "inherits": "win64",
            "displayName": "Windows 64bit Debug",
            "cacheVariables": {
                "RTS_BUILD_OPTION_DEBUG": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win64",
            "configurePreset": "win64",
            "displayName": "Build Windows 64bit Release",
            "description": "Build Windows 64bit Release",
            "configuration": "Release"
        },
        {
            "name": "win64-debug",
            "configurePreset": "win64-debug",
            "displayName": "Build Windows 64bit Debug",
            "description": "Build Windows 64bit Debug",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "Default Test (don't use directly!)",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "timeout": 300
            }
        },
        {
            "name": "win64",
            "inherits": "default",
            "configurePreset": "win64",
            "displayName": "Test Windows 64bit Release",
            "description": "Test Windows 64bit Release",
            "configuration": "Release"
        },
        {
            "name": "win64-debug",
            "inherits": "default",
            "configurePreset": "win64-debug",
            "displayName": "Test Windows 64bit Debug",
            "description": "Test Windows 64bit Debug",
            "configuration": "Debug"
        }
    ],
    "workflowPresets": [
        {
            "name": "win64",
            "steps": [
                {
                    "type": "configure",
                    "name": "win64"
                },
                {
                    "type": "build",
                    "name": "win64"
                }
            ]
        },
        {
            "name": "win64-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "win64-debug"
                },
                {
                    "type": "build",
                    "name": "win64-debug"
                }
            ]
        }
    ]
}
