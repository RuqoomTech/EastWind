# EastWind DX9 renderer: source swap.
#
# Our DX9 files sit beside the DX8 files they replace, under DX9 names:
#   dx8wrapper.cpp -> dx9wrapper.cpp, DX8Backend.cpp -> DX9Backend.cpp,
#   texture.h -> texture_dx9.h, W3DWater.cpp -> W3DWater_dx9.cpp
# EastWind/dx9_files.txt lists every pair. In the DX9 build this file swaps each
# DX8 file for its DX9 file in every target, after all targets exist
# (cmake_language DEFER), so no upstream CMakeLists.txt is edited.
# Shared files pick the DX9 headers through #ifdef EW_RENDERER_DX9 includes,
# which EastWind/Scripts/dx9_sync_check.py writes and checks.

set(EW_DX9_FILE_LIST "${CMAKE_SOURCE_DIR}/EastWind/dx9_files.txt")
set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${EW_DX9_FILE_LIST}")

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL ew_dx9_apply_swaps)

# Lowercase, forward-slash form for path comparisons (Windows paths are case-insensitive).
function(_ew_dx9_key path out)
    file(TO_CMAKE_PATH "${path}" _p)
    cmake_path(NORMAL_PATH _p)
    string(TOLOWER "${_p}" _p)
    set(${out} "${_p}" PARENT_SCOPE)
endfunction()

function(_ew_dx9_collect_targets dir out)
    get_property(_targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(_sub IN LISTS _subdirs)
        _ew_dx9_collect_targets("${_sub}" _sub_targets)
        list(APPEND _targets ${_sub_targets})
    endforeach()
    set(${out} "${_targets}" PARENT_SCOPE)
endfunction()

# Swaps the items of a SOURCES-like list. Uses the _ew_swap_* variables of the caller.
function(_ew_dx9_swap_list items base_dir out count_var)
    set(_result "")
    set(_count ${${count_var}})
    foreach(_item IN LISTS items)
        if(_item MATCHES "^\$<")
            list(APPEND _result "${_item}")
            continue()
        endif()
        if(_item MATCHES "^\"(.*)\"$")
            # Quoted precompiled header name, resolved through the include path.
            cmake_path(GET CMAKE_MATCH_1 FILENAME _name)
            string(TOLOWER "${_name}" _name_key)
            string(MD5 _hash "${_name_key}")
            if(DEFINED _ew_swap_name_${_hash})
                string(REPLACE "${_name}" "${_ew_swap_name_${_hash}}" _item "${_item}")
                math(EXPR _count "${_count} + 1")
            endif()
            list(APPEND _result "${_item}")
            continue()
        endif()
        if(_item MATCHES "^<")
            list(APPEND _result "${_item}")
            continue()
        endif()
        cmake_path(ABSOLUTE_PATH _item BASE_DIRECTORY "${base_dir}" NORMALIZE OUTPUT_VARIABLE _abs)
        _ew_dx9_key("${_abs}" _key)
        string(MD5 _hash "${_key}")
        if(DEFINED _ew_swap_path_${_hash})
            list(APPEND _result "${_ew_swap_path_${_hash}}")
            math(EXPR _count "${_count} + 1")
        else()
            list(APPEND _result "${_item}")
        endif()
    endforeach()
    set(${out} "${_result}" PARENT_SCOPE)
    set(${count_var} ${_count} PARENT_SCOPE)
endfunction()

function(ew_dx9_apply_swaps)
    # 1. Read the pairs: <DX8 repo path> <DX9 file name> <upstream commit>
    set(_pairs 0)
    if(EXISTS "${EW_DX9_FILE_LIST}")
        file(STRINGS "${EW_DX9_FILE_LIST}" _lines)
    else()
        set(_lines "")
    endif()
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _line)
        if(_line STREQUAL "" OR _line MATCHES "^#")
            continue()
        endif()
        string(REGEX REPLACE "[ \t]+" ";" _fields "${_line}")
        list(LENGTH _fields _n)
        if(NOT _n EQUAL 3)
            message(FATAL_ERROR "EastWind DX9: bad line in dx9_files.txt: '${_line}'")
        endif()
        list(GET _fields 0 _dx8)
        list(GET _fields 1 _dx9_name)
        cmake_path(GET _dx8 PARENT_PATH _dir)
        cmake_path(GET _dx8 FILENAME _dx8_name)
        set(_dx8_abs "${CMAKE_SOURCE_DIR}/${_dx8}")
        set(_dx9_abs "${CMAKE_SOURCE_DIR}/${_dir}/${_dx9_name}")
        if(NOT EXISTS "${_dx9_abs}")
            message(FATAL_ERROR "EastWind DX9: ${_dir}/${_dx9_name} is listed in dx9_files.txt but does not exist.")
        endif()
        if(NOT EXISTS "${_dx8_abs}")
            message(WARNING "EastWind DX9: ${_dx8} no longer exists upstream; run EastWind/Scripts/dx9_sync_check.py.")
        endif()
        _ew_dx9_key("${_dx8_abs}" _key)
        string(MD5 _hash "${_key}")
        set(_ew_swap_path_${_hash} "${_dx9_abs}")
        string(TOLOWER "${_dx8_name}" _name_key)
        string(MD5 _hash "${_name_key}")
        set(_ew_swap_name_${_hash} "${_dx9_name}")
        math(EXPR _pairs "${_pairs} + 1")
    endforeach()

    # 2. Swap them in every target of the source tree.
    _ew_dx9_collect_targets("${CMAKE_SOURCE_DIR}" _targets)
    set(_swapped 0)
    foreach(_target IN LISTS _targets)
        get_target_property(_source_dir ${_target} SOURCE_DIR)
        get_target_property(_type ${_target} TYPE)
        set(_props INTERFACE_SOURCES INTERFACE_PRECOMPILE_HEADERS)
        if(NOT _type STREQUAL "INTERFACE_LIBRARY")
            list(APPEND _props SOURCES PRECOMPILE_HEADERS)
        endif()
        foreach(_prop IN LISTS _props)
            get_target_property(_value ${_target} ${_prop})
            if(_value)
                _ew_dx9_swap_list("${_value}" "${_source_dir}" _mapped _swapped)
                set_property(TARGET ${_target} PROPERTY ${_prop} "${_mapped}")
            endif()
        endforeach()
    endforeach()

    message(STATUS "EastWind DX9: ${_pairs} DX9 files listed, ${_swapped} target entries swapped")
endfunction()
