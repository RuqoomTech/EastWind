{
    "version": 6,
    "configurePresets": [
        {
            "name": "ew-win32-base",
            "displayName": "EastWind Windows 32bit base (don't use directly!)",
            "description": "Mirrors upstream's default + win32 presets. Included preset files cannot inherit from CMakePresets.json.",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "Win32",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Release,Debug,RelWithDebInfo>:Embedded>",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
                "RTS_FLAGS": "/W3",
                "RTS_BUILD_GENERALS": "OFF"
            },
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Visual Studio"
                }
            }
        },
        {
            "name": "win32-dx9",
            "inherits": "ew-win32-base",
            "displayName": "Windows 32bit Release (EastWind DX9)",
            "cacheVariables": {
                "EW_RENDERER": "DX9"
            }
        },
        {
            "name": "win32-dx9-debug",
            "inherits": "ew-win32-base",
            "displayName": "Windows 32bit Debug (EastWind DX9)",
            "cacheVariables": {
                "EW_RENDERER": "DX9",
                "RTS_BUILD_OPTION_DEBUG": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win32-dx9",
            "configurePreset": "win32-dx9",
            "displayName": "Build Windows 32bit Release (EastWind DX9)",
            "configuration": "Release"
        },
        {
            "name": "win32-dx9-debug",
            "configurePreset": "win32-dx9-debug",
            "displayName": "Build Windows 32bit Debug (EastWind DX9)",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "ew-test-base",
            "displayName": "EastWind test base (don't use directly!)",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "timeout": 300
            }
        },
        {
            "name": "win32-dx9",
            "inherits": "ew-test-base",
            "configurePreset": "win32-dx9",
            "displayName": "Test Windows 32bit Release (EastWind DX9)",
            "configuration": "Release"
        },
        {
            "name": "win32-dx9-debug",
            "inherits": "ew-test-base",
            "configurePreset": "win32-dx9-debug",
            "displayName": "Test Windows 32bit Debug (EastWind DX9)",
            "configuration": "Debug"
        }
    ]
}
